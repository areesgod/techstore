DATABASE_URL=postgresql://postgres:password@localhost:5432/techstore
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:5173

# ── SMTP Email Configuration ─────────────────────────────────────
# Leave blank to disable email (reset links will print to console instead)

# Option 1: Gmail (free)
#   1. Enable 2-Step Verification on your Google account
#   2. Go to myaccount.google.com/apppasswords
#   3. Create App Password → select "Mail"
#   4. Copy the 16-char password below
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=your@gmail.com

# Option 2: Mailtrap (free, for testing — emails never reach real inboxes)
#   Sign up at mailtrap.io → Email Testing → Inboxes → SMTP Settings
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=<mailtrap username>
# SMTP_PASSWORD=<mailtrap password>
# SMTP_FROM=noreply@techstore.com

# Option 3: SendGrid (100 free emails/day in production)
#   Sign up at sendgrid.com → Settings → API Keys → Create
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=<your SendGrid API key>
# SMTP_FROM=noreply@techstore.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@techstore.com
